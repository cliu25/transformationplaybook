<div class="phase-section">
  <div class="phase-label">
    <span class="phase-tag tag-execute">Execute</span>
    <span class="phase-step-context">Steps 5 &amp; 6 · Experimentation · Scale &amp; Adopt</span>
    <span class="challenge-pip">Prioritization &amp; Roadmap</span>
